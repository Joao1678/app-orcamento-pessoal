NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key

# OBRIGATÓRIA para a exclusão de conta (/api/account/delete).
# O GoTrue só expõe `auth.admin.deleteUser` no escopo admin, então a
# exclusão da própria conta não pode ser feita pelo navegador.
# Sem esta chave a página de configurações funciona, mas a exclusão
# responde 500.
# IMPORTANTE: não prefixe com NEXT_PUBLIC_ — essa chave contorna RLS e
# jamais deve ir para o bundle do navegador.
# Onde encontrar: Supabase Dashboard > Project Settings > API Keys.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-service-role-key
